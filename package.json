{
  "name": "oo-patterns",
  "version": "0.1.0",
  "description": "Framework-agnostic HTML, CSS and JavaScript design patterns for personal and portfolio sites.",
  "license": "MIT",
  "author": "David Fugate",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/plutado/oo-patterns.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist/css",
    "dist/js",
    "src",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./dist/js/oo.js",
    "./css": "./dist/css/oo.css",
    "./css/*": "./dist/css/*",
    "./js/*": "./dist/js/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib && vite build",
    "build:pages": "vite build --mode lib && OO_BASE=/oo-patterns/ vite build",
    "preview": "vite preview --outDir dist/site",
    "lint": "npm run lint:css && npm run lint:html",
    "lint:css": "stylelint \"src/**/*.css\" \"demo/**/*.css\"",
    "lint:html": "html-validate index.html \"demo/**/*.html\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:a11y": "node scripts/a11y-check.mjs dist/site",
    "placeholders": "node scripts/generate-placeholders.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "html-validate": "^11.4.0",
    "jsdom": "^29.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
